# Copy to .env for local Vite (`bun run dev`).
# Same-origin /api so device cookies work on both localhost and a LAN IP.
# Vite proxies /api to http://127.0.0.1:8001 (see vite.config.ts).
BASE_API_URL=/api
VITE_POS_ORIGIN=http://localhost:5174
# Browser-visible Meta App values. Never put App Secret or access tokens here.
# Google Contacts OAuth client secret, state secret, and credential keys stay
# in apps/backend/.env only. The Admin callback path is /google-contacts/oauth/callback.
VITE_WHATSAPP_CLOUD_APP_ID=your_meta_app_id
VITE_WHATSAPP_CLOUD_CONFIG_ID=your_meta_embedded_signup_config_id
VITE_WHATSAPP_CLOUD_GRAPH_VERSION=v26.0
# Local development/test setup: shows the Meta API Setup test-account form.
VITE_WHATSAPP_CLOUD_MANUAL_SETUP_ENABLED=true
VITE_WHATSAPP_BAILEYS_LINKING_ENABLED=true
