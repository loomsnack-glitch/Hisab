# Copy to .env for local Vite (`bun run dev`).
# Vite proxies /api to http://localhost:8001 (see vite.config.ts).
BASE_API_URL=/api
VITE_POS_ORIGIN=http://localhost:5174
VITE_WHATSAPP_CLOUD_APP_ID=your_meta_app_id
VITE_WHATSAPP_CLOUD_CONFIG_ID=your_meta_embedded_signup_config_id
VITE_WHATSAPP_CLOUD_GRAPH_VERSION=v26.0
