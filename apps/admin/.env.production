# Baked in at `vite build`. nginx on admin.ganatri.in proxies /api same-origin.
BASE_API_URL=/api
VITE_POS_ORIGIN=https://pos.ganatri.in

# Browser-visible Meta App values. Never put App Secret or access tokens here.
VITE_WHATSAPP_CLOUD_APP_ID=1415828396704440
VITE_WHATSAPP_CLOUD_CONFIG_ID=1576624827344427
VITE_WHATSAPP_CLOUD_GRAPH_VERSION=v26.0
# Local development/test setup: shows the Meta API Setup test-account form.
VITE_WHATSAPP_CLOUD_MANUAL_SETUP_ENABLED=true
