BASE_PATH="/api"
PORT=8001

DATABASE_URL=postgres://postgres:root@localhost:5432/ganatri?sslmode=disable

#minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET_NAME=ganatri

REDIS_URL="redis://localhost:6379"

JWT_SECRET="your_jwt_secret_key"
OWNER_JWT_SECRET="use_a_distinct_long_random_secret_for_owner_sessions"
DEVICE_SECRET_ENCRYPTION_KEY="optional_dedicated_device_secret_key"
CONSOLE_ORIGIN="https://console.ganatri.in"
# Production CORS also allows https://ganatri.in, https://admin.ganatri.in, and https://pos.ganatri.in.

#email
EMAIL_PORT=587
EMAIL_HOST="smtp.gmail.com"
EMAIL_USER="your_email@example.com"
EMAIL_PASSWORD="your_email_password"

#legacy WhatsApp Cloud API path (keep configured only if another feature uses it)
WHATSAPP_API_URL="https://graph.facebook.com/v22.0/<your_phone_number_id>/messages"
WHATSAPP_API_TOKEN="your_whatsapp_api_token"

# Meta Cloud API server configuration.
# App ID and App Secret come from the Meta Developer App. The App Secret is
# backend-only and must never be copied to apps/admin/.env or browser code.
WHATSAPP_CLOUD_GRAPH_BASE_URL="https://graph.facebook.com"
WHATSAPP_CLOUD_GRAPH_VERSION="v26.0"
WHATSAPP_CLOUD_APP_ID="your_meta_app_id"
WHATSAPP_CLOUD_APP_SECRET="your_meta_app_secret"
# Generate locally; use the same value in Meta's webhook verification form.
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN="replace-with-a-long-random-webhook-token"
# AES-GCM keyring JSON. Generate a fresh 32-byte base64 key for each version.
WHATSAPP_CLOUD_CREDENTIAL_KEYS_JSON='{"v1":"base64-encoded-32-byte-key"}'
WHATSAPP_CLOUD_CREDENTIAL_ACTIVE_KEY_VERSION=v1
# Local development/test setup: enables the Meta API Setup test-account form.
WHATSAPP_CLOUD_MANUAL_SETUP_ENABLED=true

#isolated Baileys worker
WHATSAPP_WORKER_URL="http://127.0.0.1:8100"
WHATSAPP_BAILEYS_LINKING_ENABLED=true
WHATSAPP_WORKER_TOKEN="replace-with-a-long-random-shared-secret"
WHATSAPP_MAX_PENDING_OUTBOX_PER_ACCOUNT=1000

# Local development/test setup: Cloud callers and outbox dispatch are enabled.
# The API process dispatches Cloud messages; the port-8100 worker is only for
# legacy QR-linked accounts.
WHATSAPP_CLOUD_CALLERS_ENABLED=true
WHATSAPP_CLOUD_OUTBOX_ENABLED=true
WHATSAPP_CLOUD_MEDIA_URL_TTL_SECONDS=86400
WHATSAPP_CLOUD_RECONCILIATION_TIMEOUT_SECONDS=3600

# Public invoice links. Keep the secret backend-only. The base URL must be the
# HTTPS URL reachable by WhatsApp customers and must include BASE_PATH when it
# is not already part of the reverse-proxy path.
WHATSAPP_PUBLIC_INVOICE_LINK_SECRET="replace-with-a-long-random-public-invoice-secret"
WHATSAPP_PUBLIC_INVOICE_BASE_URL="https://api.ganatri.in/api/public/whatsapp/invoices"

# Short-lived Embedded Signup state signing secret (32+ random characters).
# Keep this backend-only; the Admin app needs only the App ID and Config ID.
WHATSAPP_CLOUD_ONBOARDING_STATE_SECRET="replace-with-a-long-random-state-secret"
