BASE_PATH="/api"
PORT=8001

DATABASE_URL=postgres://postgres:root@localhost:5432/ganatri?sslmode=disable

#minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET_NAME=ganatri

REDIS_URL="redis://localhost:6379"

JWT_SECRET="your_jwt_secret_key"
DEVICE_SECRET_ENCRYPTION_KEY="optional_dedicated_device_secret_key"

#email
EMAIL_PORT=587
EMAIL_HOST="smtp.gmail.com"
EMAIL_USER="your_email@example.com"
EMAIL_PASSWORD="your_email_password"

#legacy WhatsApp Cloud API path (keep configured only if another feature uses it)
WHATSAPP_API_URL="https://graph.facebook.com/v22.0/<your_phone_number_id>/messages"
WHATSAPP_API_TOKEN="your_whatsapp_api_token"

#isolated Baileys worker
WHATSAPP_WORKER_URL="http://127.0.0.1:8100"
WHATSAPP_WORKER_TOKEN="replace-with-a-long-random-shared-secret"
WHATSAPP_MAX_PENDING_OUTBOX_PER_ACCOUNT=1000
