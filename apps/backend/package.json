{
  "name": "backend",
  "type": "module",
  "module": "index.ts",
  "private": true,
  "scripts": {
    "dev": "cd ../../ && bun --env-file apps/backend/.env --watch apps/backend/src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts src/scripts/console-create-owner.ts src/scripts/dry-run-bill-number-repair.ts --outdir dist --minify --production --target bun --external pdfkit",
    "test": "bun test src",
    "console:create-owner": "bun --env-file=.env dist/scripts/console-create-owner.js",
    "owner:create": "bun --env-file=.env dist/scripts/console-create-owner.js",
    "add-initial-data": "bun run src/scripts/add-initial-data.ts",
    "grant-all-permissions-in-admin-roles": "bun run src/scripts/admin-permissions.ts",
    "db:audit-schema": "bun --env-file=.env src/scripts/audit-schema-drift.ts",
    "billing:numbering-dry-run": "bun run src/scripts/dry-run-bill-number-repair.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@repo/types": "workspace:*",
    "axios": "^1.13.5",
    "google-contacts-worker": "workspace:*",
    "hono": "^4.11.9",
    "minio": "^8.0.6",
    "nodemailer": "^8.0.1",
    "pdfkit": "0.19.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "0.17.6",
    "dbmate": "^2.30.0"
  }
}
