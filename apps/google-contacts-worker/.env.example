# Local backend is PORT=8001. Production ganatri.in must use 8181:
# GOOGLE_CONTACTS_API_URL=http://127.0.0.1:8181/api
GOOGLE_CONTACTS_API_URL=http://127.0.0.1:8001/api
# Must match apps/backend/.env GOOGLE_CONTACTS_WORKER_TOKEN. Use a unique
# token for this service.
GOOGLE_CONTACTS_WORKER_TOKEN=replace-with-a-long-random-shared-secret
GOOGLE_CONTACTS_WORKER_ID=google-contacts-worker-0
GOOGLE_CONTACTS_WORKER_POLL_INTERVAL_MS=5000
