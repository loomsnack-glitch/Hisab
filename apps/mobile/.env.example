# Physical phone: use your PC's LAN IP (find it with `ipconfig` on Windows).
# Example:
# EXPO_PUBLIC_BASE_API_URL=http://192.168.1.10:8001/api
#
# Android emulator: localhost is auto-rewritten to 10.0.2.2.
# USB-connected phone alternative: run `adb reverse tcp:8001 tcp:8001` and keep localhost.
EXPO_PUBLIC_BASE_API_URL=http://localhost:8001/api
# Production API (after ganatri.in is live):
# EXPO_PUBLIC_BASE_API_URL=https://ganatri.in/api
